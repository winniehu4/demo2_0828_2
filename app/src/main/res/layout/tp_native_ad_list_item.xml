<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/native_outer_view"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/white"
    android:padding="6dp">

    <!-- 主图 -->
    <RelativeLayout
        android:id="@+id/tp_native_main_image"
        android:layout_width="match_parent"
        android:layout_height="140dp">

        <ImageView
            android:id="@+id/tp_mopub_native_main_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop" />
    </RelativeLayout>

    <!-- 支持视频 -->
    <FrameLayout
        android:id="@+id/tp_native_main_video"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:visibility="gone" />

    <!-- AdChoices -->
    <LinearLayout
        android:id="@+id/tp_layout_ad"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentTop="true"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/tp_ad_choices_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="2dp" />

        <ImageView
            android:id="@+id/tp_native_ad_choice"
            android:layout_width="28dp"
            android:layout_height="15dp" />
    </LinearLayout>

    <!-- 底部内容 -->
    <LinearLayout
        android:id="@+id/tp_native_bottom_area"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/tp_native_main_image"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <!-- Icon -->
        <ImageView
            android:id="@+id/tp_native_icon_image"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="top"
            android:scaleType="centerCrop" />

        <!-- 文本区域 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tp_native_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:textColor="#111111"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tp_native_advertiser"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:textColor="#666666"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tp_native_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="2"
                android:textColor="#444444"
                android:textSize="12sp" />

            <!-- 支持显示评分 -->
            <TextView
                android:id="@+id/tp_native_star"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#FF9800"
                android:textSize="11sp" />

            <!-- CTA 按钮 -->
            <Button
                android:id="@+id/tp_native_cta_btn"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="6dp"
                android:text="Install" />
        </LinearLayout>

    </LinearLayout>

</RelativeLayout>