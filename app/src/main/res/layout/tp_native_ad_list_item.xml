<?xml version="1.0" encoding="utf-8"?>

<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/native_outer_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- 主图 -->
    <RelativeLayout
        android:id="@+id/tp_native_main_image"
        android:layout_width="match_parent"
        android:layout_height="420dp">

        <ImageView
            android:id="@+id/tp_mopub_native_main_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:adjustViewBounds="true"
            android:scaleType="centerCrop"/>
    </RelativeLayout>

    <!-- 视频 -->
    <FrameLayout
        android:id="@+id/tp_native_main_video"
        android:layout_width="match_parent"
        android:layout_height="420dp"
        android:visibility="gone"/>

    <!-- ad choice -->
    <LinearLayout
        android:id="@+id/tp_layout_ad"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:padding="6dp"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/tp_ad_choices_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <ImageView
            android:id="@+id/tp_native_ad_choice"
            android:layout_width="32dp"
            android:layout_height="18dp"/>


    </LinearLayout>

    <!-- 底部 -->
    <LinearLayout
        android:id="@+id/tp_native_bottom_area"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/tp_native_main_image"
        android:padding="16dp"
        android:orientation="horizontal">

        <!-- icon -->
        <ImageView
            android:id="@+id/tp_native_icon_image"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:scaleType="centerCrop"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tp_native_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#111111"
                android:maxLines="2"/>

            <TextView
                android:id="@+id/tp_native_advertiser"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textSize="14sp"
                android:textColor="#666666"/>

            <TextView
                android:id="@+id/tp_native_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textSize="15sp"
                android:textColor="#444444"
                android:maxLines="3"/>

            <TextView
                android:id="@+id/tp_native_star"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textSize="14sp"
                android:textColor="#FF9800"/>

            <Button
                android:id="@+id/tp_native_cta_btn"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:text="Install"
                android:textSize="18sp"/>
        </LinearLayout>

    </LinearLayout>

</RelativeLayout>